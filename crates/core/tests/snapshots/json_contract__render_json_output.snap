27\">&#x1d465;</text><text x=\"12.96\" y=\"11.6\" font-family=\"'ORIHA STIX Two Math', 'STIX Two Math', 'Cambria Math', serif\" font-size=\"12.6\" fill=\"#111827\">2</text></svg></span></p><figure id=\"14\" class=\"oriha-mermaid\" data-oriha-block-kind=\"codeBlock\" data-oriha-code-language=\"mermaid\"><svg id=\"mermaid-14\" xmlns=\"http://www.w3.org/2000/svg\" width=\"196\" height=\"244\" viewBox=\"0 0 196 244\" role=\"img\"><defs><marker id=\"mermaid-14-arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"8\" markerHeight=\"8\" orient=\"auto-start-reverse\"><path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#d1d9e0\"/></marker></defs><rect class=\"oriha-mermaid-svg-bg\" x=\"0\" y=\"0\" width=\"196\" height=\"244\" rx=\"12\" fill=\"#ffffff\"/><g class=\"oriha-mermaid-flowchart\"><path class=\"oriha-mermaid-edge\" d=\"M 98 86 L 98 122 L 98 122 L 98 158\" fill=\"none\" stroke=\"#d1d9e0\" stroke-width=\"1.6\" marker-end=\"url(#mermaid-14-arrow)\"/><g class=\"oriha-mermaid-node\"><rect x=\"34\" y=\"34\" width=\"128\" height=\"52\" rx=\"8\" fill=\"#ffffff\" stroke=\"#d1d9e0\" stroke-width=\"1.4\"/><text x=\"98\" y=\"64.40\" text-anchor=\"middle\" fill=\"#333333\" font-family=\"-apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif\" font-size=\"16\" font-weight=\"600\"><tspan x=\"98\">A</tspan></text></g><g class=\"oriha-mermaid-node\"><rect x=\"34\" y=\"158\" width=\"128\" height=\"52\" rx=\"8\" fill=\"#ffffff\" stroke=\"#d1d9e0\" stroke-width=\"1.4\"/><text x=\"98\" y=\"188.40\" text-anchor=\"middle\" fill=\"#333333\" font-family=\"-apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif\" font-size=\"16\" font-weight=\"600\"><tspan x=\"98\">B</tspan></text></g></g></svg></figure>\n</article>",
